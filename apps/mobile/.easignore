# EAS uses this file INSTEAD of .gitignore when present, so it must list
# everything in .gitignore PLUS build-only artifacts not needed by EAS Build.
# EAS reinstalls dependencies and runs prebuild itself, so native folders and
# node_modules are regenerated remotely and should never be uploaded.

# Dependencies (reinstalled on the build server)
node_modules/

# Native projects (regenerated by prebuild on the build server)
ios/
android/

# Expo / build outputs
.expo/
dist/
web-build/
expo-env.d.ts

# Signing material (never upload)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Local env files
.env*.local

# Logs / debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS files
.DS_Store

# TypeScript build info
*.tsbuildinfo
*.orig.*

# Tests, coverage and reports (not needed to build the app)
__tests__/
__mocks__/
e2e/
coverage/
playwright-report/
test-results/
playwright/.cache/
jest-out.txt
